<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR" monitorInterval="300" shutdownHook="disable">

    <Properties>
        <property name="basePath">logs</property>
        <property name="console_log_pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%5level] ==> %m%n</property>
        <property name="log_pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%5level] ==> %m%n</property>
        <property name="every_file_size">10MB</property>
        <property name="rolling_fileName">${basePath}/out.log</property>
        <property name="rolling_filePattern">${basePath}/%d{yyyyMMdd}/out%i.log</property>
        <property name="rolling_max">10</property>
        <property name="rolling_timeInterval">1</property>
        <property name="rolling_timeModulate">true</property>
        <property name="console_print_level">DEBUG</property>
        <property name="file_print_level">DEBUG</property>
        <property name="output_log_level">INFO</property>
    </Properties>

    <Appenders>
        <!-- 1. 控制台：输出 INFO 及以上级别 (给人看) -->
        <Console name="Console" target="SYSTEM_OUT">
            <ThresholdFilter level="${console_print_level}" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${console_log_pattern}"/>
        </Console>

        <!-- 2. 业务审计日志：纯净 JSON 格式 (给机器/Loki看) -->
        <RollingFile name="AuditLog" fileName="logs/audit/audit.json"
                     filePattern="logs/audit/audit-%d{yyyy-MM-dd}.json.gz">
            <!--
                使用 PatternLayout 输出纯消息内容 (%m)，因为 AuditLogger 已经手动序列化为 JSON 了。
                %n 用于换行。
            -->
            <PatternLayout pattern="%m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>

        <!-- 3. 错误独立日志：文本格式 (给人和机器看) -->
        <RollingFile name="ErrorLog" fileName="logs/error/error.log"
                     filePattern="logs/error/error-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>

        <!-- 4. 旧版滚动日志 (保留以兼容旧习惯) -->
        <RollingFile name="RollingFile" fileName="${rolling_fileName}" filePattern="${rolling_filePattern}">
            <ThresholdFilter level="${file_print_level}" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="${rolling_timeInterval}" modulate="true"/>
                <SizeBasedTriggeringPolicy size="${every_file_size}"/>
            </Policies>
            <DefaultRolloverStrategy max="${rolling_max}">
                <Delete basePath="${basePath}" maxDepth="2">
                    <IfLastModified age="1d"/>
                    <IfAccumulatedFileSize exceeds="100MB" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- 业务 Logger (Loki) -->
        <Logger name="audit" level="INFO" additivity="false">
            <AppenderRef ref="AuditLog"/>
            <AppenderRef ref="ErrorLog"/> <!-- 错误同时也写到 ErrorLog -->
            <AppenderRef ref="Console" level="WARN"/>  <!-- 错误同时也输出到控制台，但只显示WARN及以上 -->
        </Logger>

        <!-- 关闭 Druid 日志输出 -->
        <Logger name="com.alibaba.druid" level="ERROR">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- 根 Logger -->
        <Root level="${output_log_level}">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/> <!-- 保留旧版文件日志 -->
            <AppenderRef ref="ErrorLog"/>    <!-- 同时也记录错误到 Loki 专用错误日志 -->
        </Root>
    </Loggers>
</Configuration>